local WEAPON_NAMES = {
    "Revolver", "Winchester", "Rifle", "Colt", "Peacemaker",
    "Deringer", "Derringer", "Shotgun", "Gun", "Pistol", "Carbine"
}

local currentGunPoint = nil

local function findGunPoint()
    if not character then return nil end
    for _, name in ipairs(WEAPON_NAMES) do
        local weapon = character:FindFirstChild(name)
        if weapon then
            for _, desc in ipairs(weapon:GetDescendants()) do
                if desc:IsA("Attachment") and string.lower(desc.Name):find("gunpoint") then
                    return desc
                end
            end
        end
    end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("Attachment") and string.lower(desc.Name):find("gunpoint") then
                    return desc
                end
            end
        end
    end
    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                for _, desc in ipairs(tool:GetDescendants()) do
                    if desc:IsA("Attachment") and string.lower(desc.Name):find("gunpoint") then
                        return desc
                    end
                end
            end
        end
    end
    return nil
end

local function updateGunPoint()
    local gp = findGunPoint()
    if gp and gp ~= currentGunPoint then
        currentGunPoint = gp
    end
    return gp
end

