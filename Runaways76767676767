-- Background Loop Handler
RunService.Heartbeat:Connect(function(dt)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if hrp and hum then
        if speedModActive then
            hum.WalkSpeed = 16
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (moveDir * customCFrameSpeed * dt)
            end
        end
        if customJumpPower then
            pcall(function()
                hum.JumpPower = customJumpPower
                hum.UseJumpPower = true
            end)
        end
    end

    if noclipActive then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if hrp and showVisualizer then
        rangeRing.Transparency = 0.7
        rangeRing.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
        rangeRing.Size = Vector3.new(0.2, ATTACK_RANGE * 2, ATTACK_RANGE * 2)
    else
        rangeRing.Transparency = 1
    end

    -- Auto Attack Processing
    if isRunning and hrp then
        local npcsFolder = workspace:FindFirstChild("NPCs")
        if npcsFolder then
            for _, npcModel in ipairs(npcsFolder:GetChildren()) do
                if npcModel:IsA("Model") then
                    local npcHum = npcModel:FindFirstChildOfClass("Humanoid")
                    local rootPart = npcModel:FindFirstChild("HumanoidRootPart") or npcModel:FindFirstChild("RootPart")
                    if npcHum and rootPart and npcHum.Health > 0 then
                        if (rootPart.Position - hrp.Position).Magnitude <= ATTACK_RANGE then
                            pcall(function()
                                local ev = remoteEvent or ReplicatedStorage:FindFirstChild("Event")
                                if ev then
                                    ev:FireServer("Punches", "ReplicateSound", hrp, "Swoosh")
                                    ev:FireServer("NPCs", "Damage", npcHum, DAMAGE_AMOUNT)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end

    -- Auto Break Processing
    if autoBreakRunning and hrp then
        local mapFolder = workspace:FindFirstChild("Map")
        if mapFolder then
            local buildingsFolder = mapFolder:FindFirstChild("Buildings")
            if buildingsFolder then
                local validTargets = { ["ATM"] = true, ["CashRegister"] = true, ["Vault"] = true, ["Safe"] = true }
                for _, obj in ipairs(buildingsFolder:GetDescendants()) do
                    if obj:IsA("Model") and validTargets[obj.Name] then
                        local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if targetPart and (targetPart.Position - hrp.Position).Magnitude <= ATTACK_RANGE then
                            pcall(function()
                                local ev = remoteEvent or ReplicatedStorage:FindFirstChild("Event")
                                if ev then ev:FireServer("DamageToOpen", "Damage", obj, 1000, "melee") end
                            end)
                        end
                    end
                end
            end
        end
    end

    -- Vehicle Modifications & Gas Loop Integration
    if vehicleModActiveState then
        local vehiclesFolder = workspace:FindFirstChild("Vehicles")
        if vehiclesFolder then
            for _, car in ipairs(vehiclesFolder:GetChildren()) do
                local propFolder = car:FindFirstChild("VehicleProperty")
                for propName, val in pairs(vehicleInputs) do
                    pcall(function()
                        if propFolder then
                            propFolder:SetAttribute(propName, val)
                            propFolder[propName] = val
                        end
                        car:SetAttribute(propName, val)
                        car[propName] = val
                    end)
                end
                
                -- Safe gasLevel Value Modification
                pcall(function()
                    local gasObj = car:FindFirstChild("gasLevel")
                    if gasObj then 
                        gasObj.Value = gasLevelValue 
                    end
                end)
            end
        end
    end

    -- Auto Looting Loop
    if autoLootActive and remoteFunction then
        local lootFolder = workspace:FindFirstChild("Loot")
        if lootFolder then
            for _, lootItem in ipairs(lootFolder:GetChildren()) do
                local targetHandle = lootItem:FindFirstChild("Handle") or lootItem:FindFirstChildWhichIsA("BasePart")
                if targetHandle and (lootAllMode or selectedLootItems[lootItem.Name]) then
                    pcall(function()
                        remoteFunction:InvokeServer("Loot", "LootEquip", targetHandle)
                    end)
                end
            end
        end
    end
end)

