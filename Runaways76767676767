-- ==================== ОСНОВНОЙ ЦИКЛ ====================
local triggerLastClick = 0
local triggerLastFire = 0

RunService.RenderStepped:Connect(function()
    if WALLHACK_ENABLED then
        for targetPlayer, highlight in pairs(highlights) do
            local char = targetPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not (char and root and hum and hum.Health > 0) then
                highlight.Enabled = false
                continue
            end
            highlight.Adornee = char
            highlight.Enabled = true
            local visible = isTargetVisible(char)
            local color = visible and VISIBLE_COLOR or HIDDEN_COLOR
            highlight.FillColor = color
            highlight.OutlineColor = color
        end
    end

    local ok = pcall(function()
        if fovCircleEnabled and fovCircle then
            fovCircle.Position = getAimCenter()
            fovCircle.Color = FOV_COLOR
            fovCircle.Visible = true
        elseif fovCircle then
            fovCircle.Visible = false
        end

        if silentAimEnabled then
            updateTarget()
        else
            targetPart = nil
        end

        if not laserEnabled and not crosshairEnabled and not triggerbotEnabled then
            if not crosshairEnabled then crosshairFrame.Visible = false end
            return
        end

        local gp = updateGunPoint() or currentGunPoint
        if not gp or not gp.Parent then
            setDrawingVisible(false, false)
            crosshairFrame.Visible = false
            return
        end

        local origin = gp.WorldPosition
        local dir = gp.WorldCFrame.LookVector
        local hit = Workspace:Raycast(origin, dir * 5000, rayParams)
        local targetPos = (hit and hit.Position) or (origin + dir * 5000)

        local screenFrom = worldToScreen(origin)
        local screenTo, onScreen = worldToScreen(targetPos)

        local color = Color3.fromRGB(240, 240, 245)
        if hit and hit.Instance then
            local hitPlayer = getPlayerFromPart(hit.Instance)
            if hitPlayer then
                color = Color3.fromRGB(52, 211, 153)
            else
                color = Color3.fromRGB(248, 113, 113)
            end
        end

        if crosshairEnabled and onScreen then
            crosshairFrame.Position = UDim2.new(0, math.floor(screenTo.X), 0, math.floor(screenTo.Y))
            crosshairFrame.Visible = true
            setCrosshairColor(color)
        else
            crosshairFrame.Visible = false
        end

        if laserEnabled then
            setDrawingColor(color)
            for _, line in ipairs(laserLines) do
                line.From = screenFrom
                line.To = screenTo
                line.Visible = true
            end
        else
            for _, line in ipairs(laserLines) do line.Visible = false end
        end

        if triggerbotEnabled and hit and hit.Instance then
            local hitPlayer = getPlayerFromPart(hit.Instance)
            if hitPlayer then
                local hum = hitPlayer:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local now = os.clock()
                    if (now - triggerLastClick) >= 0.1 and (now - triggerLastFire) >= 0.075 then
                        triggerLastClick = now
                        VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.delay(0.05, function()
                            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                        end)
                        triggerLastFire = nil
                    end
                end
            end
        end
    end)

    if not ok then
        pcall(setDrawingVisible, false, false)
        if crosshairFrame then crosshairFrame.Visible = false end
    end
end)

-- ==================== ХОТКЕИ ====================
UserInput.InputBegan:Connect(function(input, gp)
    for _, btn in pairs(keybindButtons) do
        if btn.Text == "..." then return end
    end

    if gp then return end

    if input.KeyCode == Keybinds.SilentAim then toggleSilentAim()
    elseif input.KeyCode == Keybinds.FovCircle then toggleFov()
    elseif input.KeyCode == Keybinds.TargetBone then switchTarget()
    elseif input.KeyCode == Keybinds.Laser then toggleLaser()
    elseif input.KeyCode == Keybinds.Crosshair then toggleCrosshair()
    elseif input.KeyCode == Keybinds.Triggerbot or input.UserInputType == Enum.UserInputType.MouseButton3 then toggleTriggerbot()
    elseif input.KeyCode == Keybinds.Wallhack then toggleWallhack()
    elseif input.KeyCode == Keybinds.ToggleUI then toggleUI()
    elseif input.KeyCode == Keybinds.SelfDestruct then
        silentAimEnabled = false
        laserEnabled = false
        crosshairEnabled = false
        triggerbotEnabled = false
        WALLHACK_ENABLED = false
        for _, h in pairs(highlights) do h.Enabled = false end
        hideAll()
        updateUI()
        print("[SelfDestruct] Всё выключено")
    end
end)

