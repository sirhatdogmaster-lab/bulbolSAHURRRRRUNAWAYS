CombatTab:Toggle({
    Title = "Kill Aura (Tora)",
    Default = false,
    Callback = function(state)
        killAuraEnabled = state
        if killAuraEnabled then
            task.spawn(function()
                while killAuraEnabled do
                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local remote = handleRemoteEvent()
                    if root and remote then
                        local npcFolder = workspace:FindFirstChild("NPCs")
                        if npcFolder then
                            for _, npc in ipairs(npcFolder:GetChildren()) do
                                local hum = npc:FindFirstChildOfClass("Humanoid")
                                local hrp = npc:FindFirstChild("HumanoidRootPart")
                                if hum and hrp and hum.Health > 0 and (hrp.Position - root.Position).Magnitude <= killAuraRange then
                                    pcall(function() remote:FireServer("NPCs", "Damage", hum, killAuraDamage) end)
                                end
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

