local function getPlayerFromPart(part)
    if not part then return nil end
    local current = part
    while current and current ~= Workspace and current ~= game do
        if current:IsA("Model") then
            if current ~= character then
                if current:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(current) then
                    return current
                end
            else
                return nil
            end
        end
        current = current.Parent
    end
    return nil
end

local function worldToScreen(position)
    local screenPos, onScreen, depth = camera:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, depth
end

local function getAimCenter()
    return UserInput:GetMouseLocation()
end

local function formatKeyName(keycode)
    if not keycode then return "NONE" end
    local name = tostring(keycode)
    name = name:gsub("Enum.KeyCode.", "")
    name = name:gsub("Left", "L")
    name = name:gsub("Right", "R")
    name = name:gsub("Shift", "SHIFT")
    name = name:gsub("Control", "CTRL")
    name = name:gsub("Alt", "ALT")
    return name
end

-- ==================== WALLHACK (Highlight) ====================
local highlights = {}

local function isTargetVisible(targetChar)
    local myChar = localPlayer.Character
    if not myChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar, targetChar}
    local result = Workspace:Raycast(myRoot.Position, targetRoot.Position - myRoot.Position, params)
    return result == nil
end

local function createHighlight(targetPlayer)
    if highlights[targetPlayer] then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. targetPlayer.Name
    highlight.FillColor = HIDDEN_COLOR
    highlight.FillTransparency = 0.85
    highlight.OutlineColor = HIDDEN_COLOR
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = nil
    highlight.Parent = CoreGui
    highlights[targetPlayer] = highlight
end

local function removeHighlight(targetPlayer)
    if highlights[targetPlayer] then
        highlights[targetPlayer]:Destroy()
        highlights[targetPlayer] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= localPlayer then createHighlight(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= localPlayer then createHighlight(p) end
end)
Players.PlayerRemoving:Connect(function(p)
    removeHighlight(p)
end)

-- ==================== SILENT AIM ====================
local targetPart = nil
local lastTargetUpdate = 0
local hookInstalled = false
local originalRaycast = nil

local function randomHit()
    local chance = math.floor(hitChance)
    local rnd = math.floor(math.random() * 100) / 100
    return rnd <= (chance / 100)
end

local function argsMatch(args, config)
    local count = 0
    if #args < config.ArgCountRequired then return false end
    for i, v in next, args do
        if typeof(v) == config.Args[i] then
            count = count + 1
        end
    end
    return count >= config.ArgCountRequired
end

local function redirectDirection(origin, target)
    return (target - origin).Unit * 1000
end

local RAYCAST_CONFIG = {
    Raycast = {
        ArgCountRequired = 3,
        Args = {"Instance", "Vector3", "Vector3", "RaycastParams"}
    }
}

local function installHook()
    if not canHook or hookInstalled then return false end

    if hasHookmetamethod then
        hookInstalled = pcall(function()
            originalRaycast = hookmetamethod(game, "__namecall", newcclosure(function(...)
                local args = {...}
                local self = args[1]
                local method = getnamecallmethod()
                local hit = randomHit()

                if silentAimEnabled and not checkcaller() and self == Workspace and hit and method == "Raycast" and targetPart then
                    if argsMatch(args, RAYCAST_CONFIG.Raycast) then
                        local origin = args[2]
                        args[3] = redirectDirection(origin, targetPart.Position)
                        return originalRaycast(unpack(args))
                    end
                end
                return originalRaycast(...)
            end))
        end)
    end

    if not hookInstalled and hasHookfunction then
        hookInstalled = pcall(function()
            originalRaycast = Workspace.Raycast
            local newRaycast = newcclosure(function(self, origin, direction, params)
                if silentAimEnabled and not checkcaller() and self == Workspace and targetPart then
                    if argsMatch({self, origin, direction, params}, RAYCAST_CONFIG.Raycast) then
                        return originalRaycast(self, origin, redirectDirection(origin, targetPart.Position), params)
                    end
                end
                return originalRaycast(self, origin, direction, params)
            end)
            hookfunction(Workspace, "Raycast", newRaycast)
        end)
    end

    if not hookInstalled and hasReplaceclosure then
        hookInstalled = pcall(function()
            originalRaycast = Workspace.Raycast
            local newRaycast = newcclosure(function(self, origin, direction, params)
                if silentAimEnabled and not checkcaller() and self == Workspace and targetPart then
                    if argsMatch({self, origin, direction, params}, RAYCAST_CONFIG.Raycast) then
                        return originalRaycast(self, origin, redirectDirection(origin, targetPart.Position), params)
                    end
                end
                return originalRaycast(self, origin, direction, params)
            end)
            replaceclosure(Workspace.Raycast, newRaycast)
        end)
    end

    return hookInstalled
end

local function updateTarget()
    if not silentAimEnabled then
        targetPart = nil
        return
    end
    local now = os.clock()
    if (now - lastTargetUpdate) < 0.1 then return end
    lastTargetUpdate = now

    local aimCenter = getAimCenter()
    local closest = nil
    local closestDist = FOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(TARGET_PART) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - aimCenter).Magnitude
        if dist <= closestDist then
            closestDist = dist
            closest = part
        end
    end
    targetPart = closest
end

