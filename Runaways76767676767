local function toggleWallhack()
    WALLHACK_ENABLED = not WALLHACK_ENABLED
    for _, h in pairs(highlights) do
        h.Enabled = WALLHACK_ENABLED
    end
    updateUI()
end

local function toggleSilentAim()
    if not canHook then updateUI(); return end
    if not silentAimEnabled then
        if not hookInstalled then
            if not installHook() then
                canHook = false
                updateUI()
                return
            end
        end
        silentAimEnabled = true
    else
        silentAimEnabled = false
    end
    updateUI()
end

local function toggleFov()
    fovCircleEnabled = not fovCircleEnabled
    updateUI()
end

local function switchTarget()
    targetIndex = (targetIndex % #TARGET_PARTS) + 1
    TARGET_PART = TARGET_PARTS[targetIndex]
    updateUI()
end

local function decreaseFov()
    FOV = math.max(20, FOV - 5)
    if fovCircle then fovCircle.Radius = FOV end
    updateUI()
end

local function increaseFov()
    FOV = math.min(600, FOV + 5)
    if fovCircle then fovCircle.Radius = FOV end
    updateUI()
end

local function toggleLaser()
    laserEnabled = not laserEnabled
    if not laserEnabled then setDrawingVisible(false, crosshairEnabled) end
    updateUI()
end

local function toggleCrosshair()
    crosshairEnabled = not crosshairEnabled
    if not crosshairEnabled then crosshairFrame.Visible = false end
    updateUI()
end

local function toggleTriggerbot()
    triggerbotEnabled = not triggerbotEnabled
    updateUI()
end

